# ============================================================
#  V2Board Docker Environment Configuration
#  Copy to .env.docker and edit:  cp .env.docker.example .env.docker
#  Usage: docker compose --env-file .env.docker up -d --build
# ============================================================

# ---- Web Port (host port mapped to nginx:80) ----
NGINX_PORT=8080

# ---- Application ----
APP_NAME=V2Board
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root_secret_change_me
DB_DATABASE=v2board
DB_USERNAME=v2board
DB_PASSWORD=v2board_secret_change_me

# ---- Redis ----
REDIS_PASSWORD=

# ---- Admin Account (created on first init) ----
# Leave ADMIN_PASSWORD empty to auto-generate a random one
ADMIN_EMAIL=admin@v2board.com
ADMIN_PASSWORD=

# ---- Mail (SMTP) ----
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
